PORT=4000
NODE_ENV=development

# Use the same values as ITrustLD_Existing (Laravel) .env
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itrustld_live
DB_USERNAME=root
DB_PASSWORD=

# When DB_CONNECTION=sqlite, path to the Laravel SQLite file:
# DB_DATABASE=../ITrustLD_Existing/database/database.sqlite

# AWS S3 (KYC documents, deposit proofs — same as Laravel when FILESYSTEM_DISK=s3)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@itrustld.com
MAIL_FROM_NAME=iTrustLD
USER_APP_URL=http://localhost:3000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=12h

# User portal URL (for verification links in emails)
USER_APP_URL=http://localhost:3000

# Public API origin for wallet logos and other media URLs (required in production)
# Example: http://13.233.100.125:4000/api/v1  or  https://api.example.com/api/v1
# API_PUBLIC_URL=http://YOUR_SERVER_IP:4000/api/v1

APP_TIMEZONE=Asia/Colombo

# Dialog eSMS v2 (https://esms.dialog.lk)
# Quote the password if it contains #. Use API username (not username-web).
SMS_API_USERNAME=
SMS_API_PASSWORD=
SMS_API_LOGIN_URL=https://esms.dialog.lk/api/v2/user/login
SMS_API_SEND_URL=https://esms.dialog.lk/api/v2/sms
SMS_SOURCE_ADDRESS=ITrustLD
SMS_PAYMENT_METHOD=0
SMS_ENABLED=true
# Legacy aliases still accepted: DIALOG_SMS_USERNAME / DIALOG_SMS_PASSWORD

# Optional international SMS (Twilio). LK numbers still use Dialog when configured.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Mail — uses ITrustLD_Existing/.env when present (MAIL_* variables)
# Local dev options:
#   1) MAIL_MAILER=log — OTP shown on verify page + backend console (no real email)
#   2) Run Mailpit (SMTP :2525, UI http://localhost:8025) — emails caught locally
#   3) MAIL_MAILER=smtp + real credentials — delivers to real inbox (Gmail app password, etc.)

# Cloudflare Turnstile (register) — same as Laravel: only the secret in env.
# Site key is hardcoded in ITrustLD_User (and Laravel register.blade.php).
# TURNSTILE_SECRET_KEY=

# Run pending Backend migrations on API boot (default true). Set false for manual deploy migrate.
# AUTO_MIGRATE=false
