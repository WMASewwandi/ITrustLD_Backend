# ITrustLD_Backend — production environment
# Copy: cp deploy/env/backend.env.example ITrustLD_Backend/.env
#
# DB_* must match ITrustLD_Existing (Laravel) .env on the dev server.

PORT=4000
NODE_ENV=production

# --- Database (shared with Laravel) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itrustld
DB_USERNAME=root
DB_PASSWORD=

# Remote DB example:
# DB_HOST=10.0.0.2

# --- CORS: exact browser origins (scheme + host + port) ---
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

# --- Auth ---
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=12h

# --- User portal (verification links in emails) ---
USER_APP_URL=https://www.example.com

# --- Timezone (shifts / business days) ---
APP_TIMEZONE=Asia/Colombo

# --- Mail (copy from Laravel .env if needed) ---
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=iTrustLD

# --- AWS S3 (KYC documents, deposit proofs — same as Laravel when FILESYSTEM_DISK=s3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=

# --- SMS ---
# DIALOG_SMS_USERNAME=
# DIALOG_SMS_PASSWORD=
# SMS_ENABLED=true

# --- Turnstile ---
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# --- Temporary registration test bypass (dev/staging only) ---
# REGISTRATION_TEST_BYPASS=true
# REGISTRATION_TEST_EMAIL=wmavishkasewwandi@gmail.com
# REGISTRATION_TEST_PHONE=94789251014,789251014
