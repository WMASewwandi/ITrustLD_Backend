# ITrustLD_Backend — remote DB (new-stack EC2 → shared MySQL on dev server)
# Copy to ITrustLD_Backend/.env on itrustld-new-stack

PORT=4000
NODE_ENV=production

DB_CONNECTION=mysql
DB_HOST=172.31.5.244
DB_PORT=3306
DB_DATABASE=itrustld
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Replace with your new-stack public IP or domain
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:3000,http://YOUR_SERVER_IP:3001
USER_APP_URL=http://YOUR_SERVER_IP:3000

JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=12h
APP_TIMEZONE=Asia/Colombo

# Mail — copy MAIL_* from Laravel dev server .env when ready
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=iTrustLD
