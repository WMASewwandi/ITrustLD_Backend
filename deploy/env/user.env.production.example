# ITrustLD_User — production environment
# Copy: cp deploy/env/user.env.production.example ITrustLD_User/.env.local
#
# NEXT_PUBLIC_* are embedded at build time — rebuild after changing them.

NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api/v1
NEXT_PUBLIC_APP_TIMEZONE=Asia/Colombo
NEXT_PUBLIC_USER_APP_URL=http://YOUR_SERVER_IP:3000
