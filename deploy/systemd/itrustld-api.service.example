# systemd unit — ITrustLD_Backend API
#
# Install:
#   sudo cp deploy/systemd/itrustld-api.service.example /etc/systemd/system/itrustld-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now itrustld-api
#
# Edit User=, WorkingDirectory=, and EnvironmentFile= before enabling.

[Unit]
Description=iTrustLD Express API
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/itrustld/ITrustLD_Backend
EnvironmentFile=/var/www/itrustld/ITrustLD_Backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=itrustld-api

# Hardening (optional — adjust if Node needs more paths)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
