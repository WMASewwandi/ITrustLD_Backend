# iTrustLD — nginx reverse proxy (example)
#
# Install:
#   sudo cp deploy/nginx/itrustld.conf.example /etc/nginx/sites-available/itrustld
#   sudo ln -sf /etc/nginx/sites-available/itrustld /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Replace:
#   - api.example.com, admin.example.com, www.example.com
#   - SSL certificate paths (or use certbot)

# API — ITrustLD_Backend (port 4000)
upstream itrustld_api {
    server 127.0.0.1:4000;
    keepalive 16;
}

# User app — ITrustLD_User (port 3000)
upstream itrustld_user {
    server 127.0.0.1:3000;
    keepalive 16;
}

# Admin app — ITrustLD_Admin (port 3001)
upstream itrustld_admin {
    server 127.0.0.1:3001;
    keepalive 16;
}

# --- API ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://itrustld_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

# --- User portal ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.example.com example.com;

    ssl_certificate     /etc/letsencrypt/live/www.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.example.com/privkey.pem;

    location / {
        proxy_pass http://itrustld_user;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- Admin portal ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.example.com;

    ssl_certificate     /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;

    location / {
        proxy_pass http://itrustld_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Optional HTTP → HTTPS redirects
server {
    listen 80;
    listen [::]:80;
    server_name api.example.com www.example.com example.com admin.example.com;
    return 301 https://$host$request_uri;
}
